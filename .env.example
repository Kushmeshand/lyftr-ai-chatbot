# Lyftr AI Chatbot Environment Variables

# Comma-separated list of Gemini API keys (at least 2).
# Assigned IDs: key_1, key_2, etc. in order.
LLM_API_KEYS=your_gemini_api_key_1_here,your_gemini_api_key_2_here

# SQLite Database URL
# For Docker Compose: sqlite:////data/app.db
# For Local Run: sqlite:///./data/app.db
DATABASE_URL=sqlite:////data/app.db

# Allowed CORS Origins (comma-separated or * for development)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enables the X-Simulate-Failure header hook for testing failover
ENABLE_FAILURE_SIMULATION=true

# LiteLLM Model name
LLM_MODEL=gemini/gemini-2.0-flash

# Default system prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful and concise AI assistant.

# Frontend API URL configuration
VITE_BACKEND_URL=http://localhost:8000
